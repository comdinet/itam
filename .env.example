# Copy to .env and edit, or just run ./setup.sh which writes this for you.
# Plain KEY=value only - no "export", no quotes needed. .env is gitignored.

# --- HTTPS --------------------------------------------------------------
# The hostname people type in the browser. TLS is terminated by the bundled
# Caddy container.
ITAM_SITE_ADDRESS=itam.example.com

# "internal"        -> certificate from Caddy's own local CA (internal names,
#                      IP addresses, localhost). Browsers warn until you trust
#                      that CA.
# an email address  -> automatic Let's Encrypt certificate for the hostname
#                      above. Needs public DNS and ports 80+443 reachable.
ITAM_TLS=internal

ITAM_HTTP_PORT=80
ITAM_HTTPS_PORT=443

# --- Local sign-in ------------------------------------------------------
# The first admin account, created on first start. If ITAM_ADMIN_PASSWORD is
# left empty the app generates one, prints it to the log, and forces a change
# at first sign-in.
ITAM_ADMIN_USER=admin
ITAM_ADMIN_PASSWORD=

# How long a sign-in lasts before it expires (hours).
ITAM_SESSION_HOURS=12

# Session cookies are HTTPS-only by default. Only set to 0 if you have
# deliberately put the app on plain HTTP.
ITAM_COOKIE_SECURE=1

# --- Entra ID user sync -------------------------------------------------
# One app registration covers users, groups and Intune. Graph APPLICATION
# permissions needed, all with admin consent:
#   User.Read.All                          people
#   Group.Read.All                         groups and membership
#   DeviceManagementManagedDevices.Read.All   Intune devices
#   DeviceManagementConfiguration.Read.All    macOS custom attributes
# Until these are set, the app has no users.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# Optional OData filters, each narrowing one sync.
#   users:   accountEnabled eq true
#   groups:  startswith(displayName,'ITAM-')
#   devices: operatingSystem eq 'macOS'
ENTRA_USER_FILTER=
ENTRA_GROUP_FILTER=
INTUNE_DEVICE_FILTER=

# --- Display / storage --------------------------------------------------
ITAM_CURRENCY=USD

# Loopback-only port for the app container itself; the public entrance is 443.
ITAM_PORT=8000

# Where the SQLite file lives. In Docker this is the mounted volume.
ITAM_DB=/data/itam.db
