# Copy to .env and edit, or just run ./setup.sh which writes this for you.
# Plain KEY=value only - no "export", no quotes needed. .env is gitignored.

# --- Deployment ---------------------------------------------------------
# Host port the app is published on.
ITAM_PORT=8000

# --- Local sign-in ------------------------------------------------------
# The first admin account, created on first start. If ITAM_ADMIN_PASSWORD is
# left empty the app generates one and prints it to the log, then forces a
# change at first sign-in.
ITAM_ADMIN_USER=admin
ITAM_ADMIN_PASSWORD=

# How long a sign-in lasts before it expires (hours).
ITAM_SESSION_HOURS=12

# Set to 1 when serving over HTTPS so session cookies are Secure-only.
ITAM_COOKIE_SECURE=0

# --- Entra ID user sync -------------------------------------------------
# App registration with the Graph APPLICATION permission User.Read.All
# (admin consent granted). Leave blank to run on demo data and add later.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# Optional: sync only part of the directory, e.g. accountEnabled eq true
ENTRA_USER_FILTER=

# --- Display / storage --------------------------------------------------
ITAM_CURRENCY=USD

# Where the SQLite file lives. In Docker this is the mounted volume.
ITAM_DB=/data/itam.db
