# Copy to .env and edit, or just run ./setup.sh which writes this for you.
# Plain KEY=value only - no "export". Values may contain spaces and quotes as
# written; do not wrap the whole value in quotes. .env is gitignored.

# --- HTTPS --------------------------------------------------------------
# Names people will use in the browser, comma separated. ./make-cert.sh builds
# a self-signed certificate covering all of them (plus localhost and this
# host's IP), and Caddy serves it for every request - so any name reaches the
# app. Browsers warn once because the certificate is self-signed.
#
# This is a value in a file, not a command to run in a shell.
ITAM_SITE_ADDRESS=itam.example.com, itam

ITAM_HTTP_PORT=80
ITAM_HTTPS_PORT=443

# --- Local sign-in ------------------------------------------------------
# The first admin account, created on first start. If ITAM_ADMIN_PASSWORD is
# left empty the app generates one, prints it to the log, and forces a change
# at first sign-in.
ITAM_ADMIN_USER=admin
ITAM_ADMIN_PASSWORD=

# How long a sign-in lasts before it expires (hours).
ITAM_SESSION_HOURS=12

# Session cookies are HTTPS-only by default. Only set to 0 if you have
# deliberately put the app on plain HTTP.
ITAM_COOKIE_SECURE=1

# --- Entra ID user sync -------------------------------------------------
# One app registration covers users, groups and Intune. Graph APPLICATION
# permissions needed, all with admin consent:
#   User.Read.All                          people
#   Organization.Read.All                  licence SKUs the tenant owns
#   Group.Read.All                         groups and membership
#   DeviceManagementManagedDevices.Read.All   Intune devices
#   DeviceManagementConfiguration.Read.All    macOS custom attributes
# Until these are set, the app has no users.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# Optional OData filters, each narrowing one sync. Values may contain spaces
# and quotes exactly as written - do not add quotes around the whole value.
#
# Recommended: real staff only, leaving out disabled accounts and guests.
ENTRA_USER_FILTER=accountEnabled eq true and userType eq 'Member'

# e.g. startswith(displayName,'ITAM-')
ENTRA_GROUP_FILTER=

# e.g. operatingSystem eq 'macOS'
INTUNE_DEVICE_FILTER=

# --- Display / storage --------------------------------------------------
ITAM_CURRENCY=USD

# Loopback-only port for the app container itself; the public entrance is 443.
ITAM_PORT=8000

# Where the SQLite file lives. In Docker this is the mounted volume.
ITAM_DB=/data/itam.db
